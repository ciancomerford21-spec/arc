{
  "schemaVersion": 1,
  "id": "arc.status",
  "name": "Arc",
  "version": "0.1.0",
  "author": "Arc",
  "description": "Arc voice assistant. Click: open the panel (live transcript and confirmations). Right-click: talk. Middle-click: stop speaking.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Arc assistant",
    "description": "Arc state, live transcript, and confirmation for held actions",
    "category": "Assistant",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "hideWhenOffline": false,
      "historyLines": 40
    },
    "schema": [
      {
        "key": "hideWhenOffline",
        "type": "boolean",
        "label": "Hide when the daemon is offline",
        "defaultValue": false
      },
      {
        "key": "historyLines",
        "type": "integer",
        "label": "Transcript lines to keep",
        "min": 4,
        "max": 200,
        "step": 4,
        "defaultValue": 40
      }
    ]
  }
}
