[Unit]
Description=Arc local language model (llama.cpp)
Documentation=file://%h/Projects/arc/README.md

[Service]
Type=simple
ExecStart=%h/.local/share/arc/bin/arc-llm
Restart=on-failure
RestartSec=5
# The model takes a few seconds to load; don't let a crash loop hog the GPU.
StartLimitIntervalSec=120
StartLimitBurst=4

[Install]
WantedBy=default.target
